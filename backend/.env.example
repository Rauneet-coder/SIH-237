# ── Server Configuration ─────────────────────────────────────
PORT=8000
NODE_ENV=development
CORS_ORIGIN=*

# ── MongoDB Connection ───────────────────────────────────────
# Local default:
MONGODB_URI=mongodb://127.0.0.1:27017/sih237
# Docker compose service URL:
# MONGODB_URI=mongodb://sih:sih_secret@mongodb:27017/sih237?authSource=admin

# ── JWT Authentication ───────────────────────────────────────
JWT_SECRET=dev_secret_sih26237_change_in_production_key_32chars
JWT_EXPIRES_IN=24h

# ── Server Provenance Signing Authority Keypair ──────────────
# If not provided, an RSA-2048 keypair will be generated automatically on startup
# SERVER_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# SERVER_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
