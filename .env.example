# ── Backend Configuration ────────────────────────────────────────────────
PORT=8000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=INFO
OFFLINE_MODE=true

# ── MongoDB Connection ───────────────────────────────────────────────────
MONGODB_URI=mongodb://sih:sih_secret@mongodb:27017/sih237?authSource=admin

# ── JWT Authentication ───────────────────────────────────────────────────
JWT_SECRET=dev_secret_sih26237_change_in_production_key_32chars
JWT_EXPIRES_IN=24h

# ── Watermark & Forensic Service ──────────────────────────────────────────
WATERMARK_SERVICE_URL=http://watermark-service:8001
WATERMARK_TIMEOUT_MS=5000

# ── Local Key Agent (Isolated Private Key Enclave) ───────────────────────
