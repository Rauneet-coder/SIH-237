# ── Backend Configuration ────────────────────────────────────────────────
PORT=8000
NODE_ENV=production
CORS_ORIGIN=http://localhost:3000

# ── MongoDB Connection ───────────────────────────────────────────────────
MONGODB_URI=mongodb://sih:sih_secret@mongodb:27017/sih237?authSource=admin

# ── JWT Authentication ───────────────────────────────────────────────────
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_SECRET_STRING_32_CHARS
JWT_EXPIRES_IN=24h

# ── Provenance Server Authority Keypair (Optional, auto-generated if omitted) ──
# SERVER_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# SERVER_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# ── Frontend ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api
