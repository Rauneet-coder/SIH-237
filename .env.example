# ── Document Storage Vault (Air-Gapped Encrypted Packages) ───────────────
ENCRYPTED_STORAGE_DIR=./storage/encrypted

# ── Hyperledger Fabric Network (Offline & Air-Gapped) ─────────────────────
FABRIC_ENABLED=false
FABRIC_CHANNEL=provenance-channel
FABRIC_CHAINCODE=provenance
FABRIC_GATEWAY_PEER=peer0.org1.example.com
FABRIC_MSP_ID=Org1MSP

